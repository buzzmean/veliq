<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Neexitlag.Desktop">
 <!-- VELIQ dark theme. Values mirror design/tokens/tokens.json (dark scheme) and app-ui/assets/components.css. -->
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/VELIQ;component/Assets/Icons.xaml"/><ResourceDictionary Source="/VELIQ;component/Assets/VeliqBrand.xaml"/></ResourceDictionary.MergedDictionaries>
 <FontFamily x:Key="VeliqFont">./Fonts/#Onest, Segoe UI</FontFamily>
 <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

 <Color x:Key="BgColor">#0A0A0B</Color>
 <SolidColorBrush x:Key="Bg" Color="#0A0A0B"/>
 <SolidColorBrush x:Key="BgSunken" Color="#060607"/>
 <SolidColorBrush x:Key="BgRaised" Color="#131417"/>
 <SolidColorBrush x:Key="Ink850" Color="#1A1C20"/>
 <SolidColorBrush x:Key="Ink800" Color="#22252A"/>
 <SolidColorBrush x:Key="Line" Color="#22252A"/>
 <SolidColorBrush x:Key="LineStrong" Color="#30343B"/>
 <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="TextMuted" Color="#B5B9BF"/>
 <SolidColorBrush x:Key="TextFaint" Color="#8E939C"/>
 <SolidColorBrush x:Key="Accent" Color="#F0502A"/>
 <SolidColorBrush x:Key="AccentText" Color="#FF8C6B"/>
 <SolidColorBrush x:Key="Control" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="OnControl" Color="#0A0A0B"/>
 <SolidColorBrush x:Key="ControlHover" Color="#E9EBEE"/>
 <SolidColorBrush x:Key="Ok" Color="#3CCB8B"/>
 <SolidColorBrush x:Key="Warn" Color="#F2C14A"/>
 <SolidColorBrush x:Key="Danger" Color="#FF6B7F"/>
 <SolidColorBrush x:Key="DangerTint" Color="#1F1215"/>
 <SolidColorBrush x:Key="Swe" Color="#7FA2FF"/>
 <!-- Kept for older keys used by dialogs. -->
 <SolidColorBrush x:Key="Panel" Color="#131417"/>

 <ui:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
 <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
 <ui:BoolToCollapsedConverter x:Key="BoolToCollapsed"/>

 <!-- ===== Text ===== -->
 <!-- No implicit TextBlock style: it would override button Foreground (white text on the white Primary button). Text colour is inherited from the window. -->
 <Style x:Key="Display" TargetType="TextBlock"><Setter Property="FontSize" Value="40"/><Setter Property="FontWeight" Value="ExtraBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="33"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
 <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
 <Style x:Key="GroupTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{StaticResource TextFaint}"/><Setter Property="Margin" Value="2,0,0,8"/></Style>
 <Style x:Key="Lead" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
 <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextFaint}"/><Setter Property="FontSize" Value="12"/></Style>
 <Style x:Key="Small" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextFaint}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="2,10,2,10"/></Style>
 <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/></Style>

 <!-- ===== Surfaces ===== -->
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource BgRaised}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 <Style x:Key="PanelBox" TargetType="Border"><Setter Property="Background" Value="{StaticResource BgRaised}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
 <Style x:Key="SetRow" TargetType="Border"><Setter Property="Padding" Value="16,12"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
 <Style x:Key="Banner" TargetType="Border"><Setter Property="Background" Value="{StaticResource DangerTint}"/><Setter Property="BorderBrush" Value="{StaticResource Danger}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
 <Style x:Key="IconPath" TargetType="Path"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/><Setter Property="StrokeThickness" Value="1.75"/><Setter Property="StrokeLineJoin" Value="Miter"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>

 <!-- ===== Buttons: ghost by default, Primary = white control, Quiet = no border ===== -->
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="MinHeight" Value="34"/>
  <Setter Property="Padding" Value="14,7"/>
  <Setter Property="Margin" Value="0,0,8,8"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Ink850}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextFaint}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Foreground" Value="{StaticResource OnControl}"/>
  <Setter Property="Background" Value="{StaticResource Control}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Control}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="False"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHover}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="Padding" Value="10,6"/>
 </Style>

 <!-- Navigation rail: Content stays a localized string, the icon comes from ui:Nav.Icon. -->
 <Style x:Key="NavButton" TargetType="Button">
  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
  <Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Height" Value="40"/>
  <Setter Property="Margin" Value="0,0,0,2"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Grid>
      <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
       <StackPanel Orientation="Horizontal" Margin="12,0">
        <Path Data="{Binding (ui:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource IconPath}" Stroke="{TemplateBinding Foreground}" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
       </StackPanel>
      </Border>
      <Rectangle x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="-10,12,0,12" Fill="{StaticResource Accent}" Visibility="Collapsed" RadiusX="1.5" RadiusY="1.5"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgRaised}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="ui:Nav.IsCurrent" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgRaised}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line}"/><Setter TargetName="Marker" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Segmented control item (.seg button). -->
 <Style x:Key="SegButton" TargetType="Button">
  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
  <Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="1,0">
      <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="False"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="ui:Nav.IsCurrent" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgRaised}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="Seg" TargetType="Border"><Setter Property="Background" Value="{StaticResource BgSunken}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="3"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>

 <!-- Main button: the Q outline (radius 36%, slit at 66%, signal bar inside the slit). -->
 <Style x:Key="GoButton" TargetType="Button">
  <Setter Property="Width" Value="248"/>
  <Setter Property="Height" Value="248"/>
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="FontSize" Value="20"/>
  <Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <!-- As in .go: slit and signal bar live inside the outline (overflow:hidden on the padding box). -->
     <Border x:Name="Outline" CornerRadius="89" BorderThickness="2" BorderBrush="{StaticResource LineStrong}" Background="{StaticResource BgRaised}">
      <Grid>
       <!-- Geometry clip, not an OpacityMask: a VisualBrush mask is stretched over the drawn content (only the slit row), which squeezed the rounded mask into a lens across the button. -->
       <Grid>
        <Grid.Clip><RectangleGeometry Rect="0,0,244,244" RadiusX="87" RadiusY="87"/></Grid.Clip>
        <Grid.RowDefinitions><RowDefinition Height="66*"/><RowDefinition Height="6*"/><RowDefinition Height="28*"/></Grid.RowDefinitions>
        <Rectangle Grid.Row="1" Fill="{StaticResource Bg}"/>
        <Rectangle x:Name="SignalOn" Grid.Row="1" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
        <Rectangle x:Name="SignalRun" Grid.Row="1" Fill="{StaticResource Accent}" Width="85" HorizontalAlignment="Left" Visibility="Collapsed"><Rectangle.RenderTransform><TranslateTransform X="-90"/></Rectangle.RenderTransform></Rectangle>
       </Grid>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" RecognizesAccessKey="False"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource TextFaint}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <DataTrigger Binding="{Binding Optimizing}" Value="True">
       <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Text}"/>
       <Setter TargetName="Outline" Property="Background" Value="{StaticResource Bg}"/>
       <Setter TargetName="SignalOn" Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Busy}" Value="True">
       <Setter TargetName="SignalOn" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="SignalRun" Property="Visibility" Value="Visible"/>
       <DataTrigger.EnterActions><BeginStoryboard x:Name="Running"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="SignalRun" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-90" To="250" Duration="0:0:1.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
       <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Running"/></DataTrigger.ExitActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding Available}" Value="False"><Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Danger}"/></DataTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.7"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Status mark (.status__mark): square outline, signal bar when routing works. -->
 <Style x:Key="StatusMark" TargetType="Border">
  <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="CornerRadius" Value="4"/>
  <Setter Property="BorderThickness" Value="1.75"/><Setter Property="BorderBrush" Value="{StaticResource TextFaint}"/><Setter Property="ClipToBounds" Value="True"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding Optimizing}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Text}"/></DataTrigger>
   <DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="BorderBrush" Value="{StaticResource Danger}"/><Setter Property="CornerRadius" Value="7"/></DataTrigger>
  </Style.Triggers>
 </Style>

 <!-- ===== Inputs ===== -->
 <Style TargetType="TextBox">
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="Background" Value="{StaticResource BgRaised}"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
  <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
  <Setter Property="Padding" Value="10,0"/>
  <Setter Property="MinHeight" Value="38"/>
  <Setter Property="Margin" Value="0,4,0,10"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextFaint}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="PasswordBox">
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="Background" Value="{StaticResource BgRaised}"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
  <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
  <Setter Property="Padding" Value="14,0"/>
  <Setter Property="MinHeight" Value="48"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="PasswordBox">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextFaint}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- CheckBox is drawn as the VELIQ switch (.switch): text left, track right. -->
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="Margin" Value="0,4,16,4"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="CheckBox">
     <Grid Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="False"/>
      <Border x:Name="Track" Grid.Column="1" Width="44" Height="26" CornerRadius="13" Background="{StaticResource LineStrong}" BorderThickness="1" BorderBrush="Transparent">
       <Grid x:Name="Thumb" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,0">
        <Ellipse x:Name="Knob" Fill="{StaticResource BgRaised}"/>
        <Rectangle x:Name="Slit" Height="2" Margin="0,12.4,0,0" VerticalAlignment="Top" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
        <Grid.Clip><EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10"/></Grid.Clip>
       </Grid>
      </Border>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Control}"/><Setter TargetName="Thumb" Property="Margin" Value="20,0,0,0"/><Setter TargetName="Knob" Property="Fill" Value="{StaticResource Bg}"/><Setter TargetName="Slit" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Own every ComboBox surface: no OS light-theme popup/disabled chrome. -->
 <Style x:Key="ComboFocus" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="2" Stroke="#F0502A" StrokeThickness="1" StrokeDashArray="2,2"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem">
  <Setter Property="Background" Value="#131417"/>
  <Setter Property="Foreground" Value="#FFFFFF"/>
  <Setter Property="Padding" Value="12,9"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource ComboFocus}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2,1">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#1A1C20"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A1C20"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#22252A"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#131417"/><Setter Property="Foreground" Value="#8E939C"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="MinWidth" Value="150"/>
  <Setter Property="MinHeight" Value="38"/>
  <Setter Property="Margin" Value="0,4,8,8"/>
  <Setter Property="Padding" Value="12,8"/>
  <Setter Property="Background" Value="#131417"/>
  <Setter Property="Foreground" Value="#FFFFFF"/>
  <Setter Property="BorderBrush" Value="#30343B"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="MaxDropDownHeight" Value="320"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource ComboFocus}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="ComboBox">
    <Grid>
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
     <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter x:Name="Selection" Margin="12,8,36,8" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}"/>
     <TextBox x:Name="PART_EditableTextBox" Margin="12,6,36,6" Visibility="Hidden" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}"/>
     <Path x:Name="Arrow" IsHitTestVisible="False" Data="M 0 0 L 5 5 L 10 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
      <Border x:Name="PopupBorder" Background="#131417" BorderBrush="#30343B" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
       <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
       </ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1A1C20"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#8E939C"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F0502A"/></Trigger>
     <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F0502A"/></Trigger>
     <Trigger Property="IsEditable" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#8E939C"/><Setter TargetName="Chrome" Property="Background" Value="#060607"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#22252A"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>

 <!-- ===== Tables (.table inside .panel) ===== -->
 <Style TargetType="DataGrid">
  <Setter Property="Background" Value="{StaticResource BgRaised}"/>
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="RowBackground" Value="Transparent"/>
  <Setter Property="AlternatingRowBackground" Value="Transparent"/>
  <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
  <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
  <Setter Property="HeadersVisibility" Value="Column"/>
  <Setter Property="AutoGenerateColumns" Value="False"/>
  <Setter Property="CanUserAddRows" Value="False"/>
  <Setter Property="IsReadOnly" Value="True"/>
  <Setter Property="MinRowHeight" Value="42"/>
  <Setter Property="ColumnHeaderHeight" Value="38"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGrid">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="1" SnapsToDevicePixels="True">
      <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
       <ScrollViewer.Template>
        <ControlTemplate TargetType="ScrollViewer">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.ColumnSpan="2"/>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" CanContentScroll="{TemplateBinding CanContentScroll}"/>
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
         </Grid>
        </ControlTemplate>
       </ScrollViewer.Template>
       <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
      </ScrollViewer>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="DataGridColumnHeader">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
  <Setter Property="FontWeight" Value="Medium"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Padding" Value="14,8"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
  <Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGridColumnHeader">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="DataGridRow">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Ink850}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Ink800}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="DataGridCell">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGridCell">
     <Border Background="{TemplateBinding Background}" Padding="14,8" SnapsToDevicePixels="True">
      <ContentPresenter VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
  </Style.Triggers>
 </Style>

 <Style TargetType="ListBox">
  <Setter Property="Background" Value="{StaticResource BgSunken}"/>
  <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Padding" Value="8"/>
 </Style>

 <!-- Expander: flat header with chevron. -->
 <Style TargetType="Expander">
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="Margin" Value="0,6,0,6"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Expander">
     <DockPanel>
      <ToggleButton x:Name="Header" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" FocusVisualStyle="{x:Null}">
       <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
         <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="8,7">
          <StackPanel Orientation="Horizontal">
           <Path x:Name="Chevron" Data="{StaticResource IconChevronRight}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource TextFaint}" StrokeThickness="1.75" Margin="0,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="Turn" Angle="0"/></Path.RenderTransform></Path>
           <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </StackPanel>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgRaised}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </ToggleButton.Template>
       <ContentPresenter Content="{TemplateBinding Header}" TextElement.Foreground="{StaticResource TextMuted}" TextElement.FontWeight="Medium"/>
      </ToggleButton>
      <ContentPresenter x:Name="Body" Margin="8,8,0,0" Visibility="Collapsed"/>
     </DockPanel>
     <ControlTemplate.Triggers>
      <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Thin dark scrollbars. -->
 <Style x:Key="ScrollThumb" TargetType="Thumb">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="T" Background="{StaticResource LineStrong}" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{StaticResource TextFaint}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ScrollPage" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ScrollBar">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Width" Value="10"/>
  <Setter Property="MinWidth" Value="10"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Track x:Name="PART_Track" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
     </Track>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="Orientation" Value="Horizontal">
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Height" Value="10"/>
    <Setter Property="MinHeight" Value="10"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ScrollBar">
       <Track x:Name="PART_Track" IsDirectionReversed="False">
        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
       </Track>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Trigger>
  </Style.Triggers>
 </Style>

 <Style TargetType="ToolTip">
  <Setter Property="Background" Value="{StaticResource BgRaised}"/>
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
  <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
  <Setter Property="Padding" Value="10,6"/>
 </Style>
</ResourceDictionary>
