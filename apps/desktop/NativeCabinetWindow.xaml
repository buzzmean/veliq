<Window x:Class="Neexitlag.Desktop.NativeCabinetWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VELIQ — личный кабинет" Width="880" Height="740" MinWidth="640" MinHeight="560"
 WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
 FontFamily="{StaticResource VeliqFont}" FontSize="14" Icon="Assets/VELIQ.ico">
 <Grid Margin="28,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="Поддержка" Click="Support" Style="{StaticResource Quiet}"/>
   <StackPanel><TextBlock Text="Личный кабинет" FontSize="28" FontWeight="Bold"/><TextBlock Text="Аккаунт, подписки и компьютеры" Style="{StaticResource Small}" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
   <StackPanel><TextBlock Text="Этот компьютер" FontWeight="SemiBold"/><TextBlock x:Name="DeviceAccess" Text="Проверяем доступ…" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="DeviceHint" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  </Border>
  <ScrollViewer x:Name="CabinetContent" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel x:Name="SignInPanel" MaxWidth="420" HorizontalAlignment="Center" Margin="0,20">
     <TextBlock Text="Войти в кабинет" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock Text="Подтвердите почту, чтобы управлять своими подписками и компьютерами." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,18"/>
     <Label Content="Электронная почта" Target="{Binding ElementName=Email}" Foreground="{StaticResource TextMuted}" Padding="0"/>
     <TextBox x:Name="Email" MaxLength="254" MinHeight="44" Margin="0,8,0,12" AutomationProperties.Name="Электронная почта" KeyDown="EmailKey"/>
     <CheckBox x:Name="RememberCabinet" Visibility="Collapsed" Foreground="{StaticResource Text}" Content="Запомнить вход на этом личном ПК" Margin="0,0,0,12"/>
     <Button x:Name="SendCode" Content="Получить код" Style="{StaticResource Primary}" Click="Send" Margin="0" MinHeight="44"/>
     <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,20,0,0">
      <Label Content="Код из письма" Target="{Binding ElementName=Code}" Foreground="{StaticResource TextMuted}" Padding="0"/>
      <PasswordBox x:Name="Code" MaxLength="6" MinHeight="44" FontSize="20" Margin="0,8,0,12" AutomationProperties.Name="Код из письма" KeyDown="CodeKey"/>
      <Button x:Name="VerifyCode" Content="Войти" Click="Verify" Style="{StaticResource Primary}" Margin="0" MinHeight="44"/>
      <Button x:Name="ChangeEmail" Content="Изменить почту" Click="ChangeAddress" Style="{StaticResource Quiet}" Margin="0,8,0,0"/>
     </StackPanel>
    </StackPanel>
    <StackPanel x:Name="ResumePanel" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Center" Margin="0,20">
     <TextBlock Text="Сохранённый вход в кабинет" FontSize="22" FontWeight="SemiBold"/>
     <WrapPanel Margin="0,12,0,0"><Button Content="Проверить вход" Click="RetryRemembered"/><Button Content="Выйти из кабинета" Click="Logout"/></WrapPanel>
    </StackPanel>
    <StackPanel x:Name="ProfilePanel" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Center" Margin="0,20">
     <TextBlock Text="Завершите регистрацию" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <ComboBox x:Name="ProfileKind" SelectedIndex="0" MinHeight="44" AutomationProperties.Name="Тип аккаунта"><ComboBoxItem Content="Пользователь" Tag="player"/><ComboBoxItem Content="Клуб" Tag="club"/></ComboBox>
     <Label Content="Имя или название клуба" Target="{Binding ElementName=ProfileName}" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0"/>
     <TextBox x:Name="ProfileName" MaxLength="80" MinHeight="44" AutomationProperties.Name="Имя или название клуба"/>
     <Button x:Name="SaveProfile" Content="Сохранить" Click="CreateProfile" Style="{StaticResource Primary}" Margin="0,16,0,0"/>
     <Button x:Name="ProfileSignOut" Content="Войти в другой аккаунт" Click="Logout" Style="{StaticResource Quiet}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
     <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
      <TextBlock x:Name="AccountName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="AccountRole" Style="{StaticResource Small}" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,12,0,0"><Button x:Name="RefreshAccount" Content="Обновить" Click="Refresh"/><Button x:Name="SignOut" Content="Выйти из кабинета" Click="Logout"/></WrapPanel>
     </StackPanel></Border>
     <TextBlock x:Name="Rights" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <TextBlock Text="Подписки" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock x:Name="NoSubscriptions" Text="Подписок пока нет. Напишите в поддержку — поможем с подключением." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <ItemsControl x:Name="Subscriptions"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="{Binding AccessLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding SeatsLabel}" Margin="0,6,0,0"/><TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Border x:Name="ConnectPanel" Style="{StaticResource Card}" Padding="16">
      <StackPanel><TextBlock Text="Подключить этот компьютер" FontWeight="SemiBold"/><ComboBox x:Name="SubscriptionChoice" DisplayMemberPath="Label" MinHeight="40" Margin="0,10,0,10" AutomationProperties.Name="Подписка для компьютера"/><Button x:Name="ConnectDevice" Content="Подтвердить подключение" Click="Connect" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel>
     </Border>
     <TextBlock Text="Компьютеры аккаунта" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,12"/>
     <TextBlock x:Name="NoDevices" Text="Подключённых компьютеров пока нет." Style="{StaticResource Small}" Margin="0,0,0,18"/>
     <ItemsControl x:Name="Devices"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" Padding="16"><DockPanel><Button DockPanel.Dock="Right" Content="Отключить" Click="Release" Tag="{Binding}" IsEnabled="{Binding CanRelease}" VerticalAlignment="Center" Margin="16,0,0,0"/><StackPanel><TextBlock Text="{Binding Device.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Device.LastSeenLabel}" Style="{StaticResource Small}" Margin="0,6,0,0"/><TextBlock Text="{Binding SubscriptionLabel}" Style="{StaticResource Small}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Платежи" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,12"/>
     <TextBlock x:Name="NoPayments" Text="Платежей пока нет." Style="{StaticResource Small}"/>
     <ItemsControl x:Name="Payments"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,10"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="3" x:Name="Feedback" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
