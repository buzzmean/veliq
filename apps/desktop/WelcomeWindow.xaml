<Window x:Class="Neexitlag.Desktop.WelcomeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VELIQ — подключение" Width="960" Height="660" MinWidth="840" MinHeight="600"
 WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
 FontFamily="{StaticResource VeliqFont}" FontSize="14" Icon="Assets/VELIQ.ico">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource BgRaised}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="36,32">
   <DockPanel LastChildFill="True">
    <TextBlock DockPanel.Dock="Top" Text="VELIQ" FontSize="25" FontWeight="ExtraBold" Margin="0,0,0,40"/>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Height="1" Background="{StaticResource Line}" Margin="0,24,0,18"/>
     <TextBlock Text="Личный ПК — ваш аккаунт.&#10;Компьютер клуба — код администратора." Style="{StaticResource Small}" LineHeight="23"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center">
     <Border Width="48" Height="5" Background="{StaticResource Accent}" HorizontalAlignment="Left" Margin="0,0,0,24" CornerRadius="2"/>
     <TextBlock Text="Начните&#10;с подключения." FontSize="38" FontWeight="ExtraBold" TextWrapping="Wrap" LineHeight="44"/>
     <TextBlock Text="Игры, общение и работа —&#10;в одном приложении." Style="{StaticResource Lead}" FontSize="16" Margin="0,22,0,28" LineHeight="25"/>
     <TextBlock Text="01   Подключите компьютер" Style="{StaticResource Small}" Margin="0,0,0,13"/>
     <TextBlock Text="02   Выберите приложения" Style="{StaticResource Small}" Margin="0,0,0,13"/>
     <TextBlock Text="03   Включите VELIQ" Style="{StaticResource Small}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="32,30">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="ПОДКЛЮЧЕНИЕ КОМПЬЮТЕРА" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,22,0,16">
    <StackPanel VerticalAlignment="Center">
     <TextBlock x:Name="Heading" Text="Добро пожаловать" FontSize="29" FontWeight="Bold" TextWrapping="Wrap"/>
     <TextBlock x:Name="Lead" Text="Выберите способ подключения." Style="{StaticResource Lead}" Margin="0,12,0,22"/>
     <Grid x:Name="ChoicePanel" Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="PersonalTab" Content="Личный аккаунт" Click="SelectPersonal" MinHeight="42" Margin="0,0,6,0"/>
      <Button x:Name="CodeTab" Grid.Column="1" Content="Код подключения" Click="SelectCode" MinHeight="42" Margin="6,0,0,0"/>
     </Grid>
     <StackPanel x:Name="PersonalPanel">
      <TextBlock Text="Войдите в личный кабинет" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Откроем страницу входа в браузере. После подтверждения компьютер подключится автоматически." Style="{StaticResource Small}" Margin="0,10,0,22"/>
      <Button x:Name="SignInButton" Content="Войти" Click="SignIn" Style="{StaticResource Primary}" MinHeight="46" Margin="0,0,0,10"/>
      <Button x:Name="RegisterButton" Content="Создать аккаунт" Click="Register" MinHeight="46" Margin="0,0,0,12"/>
      <TextBlock Text="Вход и регистрация по электронной почте. Сессия сохранится на этом компьютере." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19"/>
     </StackPanel>
     <StackPanel x:Name="CodePanel" Visibility="Collapsed">
      <TextBlock Text="Код от администратора" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Введите код подключения для этого компьютера. Личный аккаунт игрока не потребуется." Style="{StaticResource Small}" Margin="0,10,0,20"/>
      <Label Content="Код подключения" Target="{Binding ElementName=ConnectionCode}" Padding="0" Margin="0,0,0,8" Foreground="{StaticResource TextMuted}"/>
      <PasswordBox x:Name="ConnectionCode" MaxLength="256" MinHeight="46" FontSize="18" Padding="12,8" Margin="0,0,0,16" AutomationProperties.Name="Код подключения" KeyDown="CodeKeyDown"/>
      <Button x:Name="ActivateButton" Content="Подключить компьютер" Click="ActivateCode" Style="{StaticResource Primary}" MinHeight="46" Margin="0,0,0,12"/>
      <TextBlock Text="Нет кода или он не подходит? Обратитесь к администратору, который выдал доступ." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19"/>
     </StackPanel>
     <StackPanel x:Name="WaitingPanel" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ожидаем подтверждение" FontWeight="SemiBold"/><TextBlock Text="Можно оставить это окно открытым. Пароль от почты здесь вводить не нужно." Style="{StaticResource Small}" Margin="0,8,0,0"/></StackPanel></Border>
      <Button x:Name="ReopenButton" Content="Открыть страницу входа" Click="ReopenBrowser" MinHeight="44" Margin="0,8,0,10"/>
      <Button Content="Выбрать другой способ" Click="BackToChoice" Margin="0"/>
     </StackPanel>
     <StackPanel x:Name="ReadyPanel" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Подключение подтверждено" Foreground="{StaticResource Ok}" FontWeight="SemiBold"/><TextBlock x:Name="AccountLabel" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
      <Button x:Name="ContinueButton" Content="Перейти в VELIQ" Click="Continue" Style="{StaticResource Primary}" MinHeight="46" Margin="0,12,0,0"/>
     </StackPanel>
     <TextBlock x:Name="Feedback" Style="{StaticResource Small}" Foreground="{StaticResource AccentText}" Margin="0,18,0,0" AutomationProperties.LiveSetting="Polite"/>
     <Button x:Name="CabinetButton" Content="Открыть личный кабинет" Click="OpenCabinet" Visibility="Collapsed" Margin="0,14,0,0" MinHeight="42"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="RetryButton" Content="Проверить подключение" Click="Retry" Style="{StaticResource Quiet}" FontSize="12" HorizontalAlignment="Left" Margin="0"/>
    <Button Grid.Column="1" Content="Закрыть" Click="ExitClick" Style="{StaticResource Quiet}" FontSize="12" Margin="0"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
